# ---------------------------------------------------------------------------
# Wingman uses any OpenAI-compatible chat completions endpoint with a vision model.
# Copy this file to .env.local and fill in your provider of choice.
# ---------------------------------------------------------------------------

# Base URL of the provider. Include the /v1 segment (or the full /chat/completions URL).
AI_BASE_URL=

# API key for that provider.
AI_API_KEY=
# Must be a vision-capable model.
# Examples: gpt-4o-mini, qwen/qwen2.5-vl-72b-instruct, meta-llama/llama-3.2-90b-vision-instruct
AI_MODEL=

# Optional: absolute URL used for SEO/OG tags.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000